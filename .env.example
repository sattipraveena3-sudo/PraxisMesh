# Runtime
PRAXISMESH_ENV=development
PRAXISMESH_HOST=0.0.0.0
PRAXISMESH_PORT=8000
PRAXISMESH_DATA_DIR=.praxismesh
PRAXISMESH_DATABASE=.praxismesh/praxismesh.db
PRAXISMESH_WORKSPACE=.praxismesh/workspaces

# Planner: deterministic or openai
PRAXISMESH_PLANNER=deterministic
PRAXISMESH_OPENAI_MODEL=gpt-5.6
OPENAI_API_KEY=

# Execution safety
PRAXISMESH_ALLOW_HTTP=false
PRAXISMESH_HTTP_ALLOWLIST=api.github.com
PRAXISMESH_AUTO_APPROVE_LOW_RISK=true
PRAXISMESH_MAX_STEPS=20
PRAXISMESH_TOOL_TIMEOUT_SECONDS=20

